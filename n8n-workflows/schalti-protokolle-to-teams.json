    {
      "parameters": {
        "url": "=http://localhost:7001/api/webhook/protokoll",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "protokollId",
              "value": "={{ $json.body.protokollId }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-request",
      "name": "HTTP Request - Hole Protokoll Daten",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "filter-abnahme",
              "leftValue": "={{ $json.aufgabe }}",
              "rightValue": "Abnahme",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-abnahme",
      "name": "Filter - Nur Abnahmen",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.TEAMS_CHAT_ID }}",
        "message": "=📋 **Neuer Arbeitsschritt**\n\n**Projekt:** {{ $json.projektName }}\n**Schaltschrank-Nr.:** {{ $json.schaltschrankNummer }}\n**Aufgabe:** {{ $json.aufgabe }}\n**Benutzer:** {{ $json.userName }}\n**Zeitaufwand:** {{ $json.zeitaufwand }}h\n**Datum:** {{ $json.datum }}\n\n{{ $json.details ? '**Details:** ' + $json.details : '' }}\n\n{{ $json.abnahmeStatus ? '**Abnahme-Status:** ' + $json.abnahmeStatus : '' }}\n{{ $json.abnahmeTyp ? '**Abnahme-Typ:** ' + $json.abnahmeTyp : '' }}",
        "options": {}
      },
      "id": "teams-message",
      "name": "Teams - Sende Nachricht",
      "type": "n8n-nodes-base.microsoftTeams",
      "typeVersion": 1,
      "position": [850, 200],
