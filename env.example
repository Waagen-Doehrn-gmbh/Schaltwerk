# ============================================
# Schalti Pro - Server Deployment Konfiguration
# ============================================
# Kopiere diese Datei zu .env und passe die Werte an
# Befehl: cp env.example .env
#
# Für manuelles Deployment: Siehe SERVER_DEPLOYMENT.md

# Datenbank Konfiguration
DB_HOST=postgres
DB_PORT=7002
DB_NAME=schalti_pro
DB_USER=postgres
DB_PASSWORD=dein-sicheres-passwort-hier

# JWT Konfiguration
# WICHTIG: Generiere einen sicheren Secret für Production!
# Beispiel: openssl rand -base64 32
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# Server Konfiguration
PORT=3001
NODE_ENV=production

# CORS Konfiguration
# Setze die IP-Adresse deines Servers
CORS_ORIGIN=http://192.168.0.199:7000

# Frontend API URL
# Setze die IP-Adresse deines Servers
NEXT_PUBLIC_API_URL=http://192.168.0.199:7001

# n8n Webhook URL (optional)
# Falls du n8n Workflows verwendest, setze hier die n8n Webhook-URL
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook

